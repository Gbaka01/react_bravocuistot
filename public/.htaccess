RewriteEngine On

# Les vrais fichiers (JS, CSS, images, sitemap…) sont servis tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routes connues de l'application → index.html avec le code 200
RewriteRule ^(recettes|recette/[0-9]+|connexion|inscription|profil|mentions-legales)?/?$ index.html [L]

# Tout le reste → index.html, mais avec le code 404
ErrorDocument 404 /index.html
